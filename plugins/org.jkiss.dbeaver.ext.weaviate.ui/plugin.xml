<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceEditorView"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
    </extension>

    <extension point="org.jkiss.dbeaver.resultset.panel">
        <panel
                id="weaviate-query"
                label="Weaviate Query"
                description="Run BM25, near text, near vector or hybrid queries against the active Weaviate collection."
                icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"
                default="true"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateQueryPanel">
            <datasource id="weaviate"/>
        </panel>
    </extension>

    <!-- Dialog shown when creating a new collection: edits the JSON definition staged by
         WeaviateCollectionManager#createNewObject. -->
    <extension point="org.jkiss.dbeaver.databaseEditor">
        <configurator class="org.jkiss.dbeaver.ext.weaviate.ui.config.WeaviateCollectionConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
        </configurator>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.replicateShard"
                name="Move or Copy Replica..."
                description="Move or copy a shard replica to another node"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
        <!-- One command per action rather than one with an "operation" parameter. setEnabled is
             given an evaluation context and no way to see which parameter an invocation carries,
             so a single handler has to enable every action wherever any of them applies, and
             Cancel appeared on movements the server would refuse to cancel. -->
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.replicationCancel"
                name="Cancel Movement"
                description="Stop a replica movement that has not passed the point of no return"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.replicationDelete"
                name="Delete Movement"
                description="Remove a replica movement record"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.replicationWatch"
                name="Follow Movement"
                description="Watch a running replica movement until it finishes"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.replicationFolder"
                name="Replication records"
                description="Clear replication records, or force out a stuck one"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <commandParameter id="operation" name="Operation" optional="false"/>
        </command>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicateShard"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/arrow_right.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationCancel"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/cancel.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationDelete"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/delete.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationWatch"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/refresh.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationFolder"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/delete.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen> on any of these: the condition is a navigator folder's meta id,
             which no built-in property tester exposes, and a tester contributed from this
             lazily-activated bundle evaluates as NOT_LOADED before the bundle starts. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicateShard"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReplicateShardHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationCancel"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReplicationCancelHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationDelete"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReplicationDeleteHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationWatch"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReplicationWatchHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationFolder"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReplicationFolderHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageRole"
                name="Role"
                description="Edit or delete a Weaviate role"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <!-- Which of edit and delete an invocation is. Labels and icons are set per entry by
                 the handler's updateElement, so the name above is never displayed: one command
                 serving several entries would otherwise give them all the same icon. -->
            <commandParameter id="operation" name="Operation" optional="false"/>
        </command>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageRolesFolder"
                name="Create Role"
                description="Create a Weaviate role"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
                name="Users"
                description="Create a database user, or act on all of them"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <commandParameter id="operation" name="Operation" optional="false"/>
        </command>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                name="Database user"
                description="Act on the selected Weaviate database users"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <commandParameter id="operation" name="Operation" optional="false"/>
        </command>
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageOidcGroup"
                name="Group roles"
                description="Grant or withdraw roles for an OIDC group"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <commandParameter id="operation" name="Operation" optional="false"/>
        </command>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- Borrowed from the shared UI bundle, which this one already requires, rather than
             shipping assets for actions the platform already has icons for. These are only the
             fallback: each handler's updateElement sets a per-entry icon, because one command
             serves several menu entries and they would otherwise all look alike. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRole"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/edit.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRolesFolder"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/add.png"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/edit.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/add.png"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageOidcGroup"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/edit.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen> on any of these: the condition is a navigator folder's meta id,
             which no built-in property tester exposes, and a tester contributed from this
             lazily-activated bundle evaluates as NOT_LOADED before the bundle starts. Each
             handler's setEnabled() computes it instead. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRole"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateRoleHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRolesFolder"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateRolesFolderHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateDbUserHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateUsersFolderHandler"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageOidcGroup"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateOidcGroupHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                name="Export Collection Schema..."
                description="Save this collection's definition as JSON"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateExportSchemaHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.createAlias"
                name="Create Alias..."
                description="Point a new name at a collection"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.createAlias"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/add.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No enabledWhen, for the reason given on the replication handlers: the condition is a
             navigator folder's meta id, which no built-in property tester exposes. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.createAlias"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateAliasFolderHandler"/>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.openModuleDocs">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.createBackup">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.restoreBackup">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.deleteCollections">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.backupDocs">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.setShardStatus">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.createAlias">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState">
                <visibleWhen checkEnabled="true"/>
            </command>
            <!-- Grouped in a submenu because these two are collection-wide settings sitting
                 beside per-tenant actions, and at the top level they read as though they were
                 more of the same. No visibleWhen on the menu itself: the children carry
                 checkEnabled and the popup drops a submenu whose contributions are all
                 invisible, which is how org.jkiss.dbeaver.cmp.simple.ui contributes its own.

                 Both entries are the same command told apart by its option parameter. Their
                 labels and icons are set per selection in the handler's updateElement, so each
                 names the change it will make rather than carrying a tick to interpret. -->
            <menu id="weaviate-multi-tenant-options" label="Multi-Tenant Options"
                  icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/tools.svg">
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                         id="weaviate.autoTenantCreation">
                    <parameter name="option" value="creation"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                         id="weaviate.autoTenantActivation">
                    <parameter name="option" value="activation"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
            </menu>
            <!-- checkEnabled hides the item on a property that is not tokenized at all, which
                 is a permanent fact about that property. A server merely being too old is not
                 handled by hiding: the handler leaves the command enabled and rewrites its label
                 to name the version required, so the feature stays discoverable. -->
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization">
                <visibleWhen checkEnabled="true"/>
            </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRolesFolder"
                         id="weaviate.roleCreate" label="Create Role...">
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRole"
                         id="weaviate.roleEdit" label="Edit Role...">
                    <parameter name="operation" value="edit"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageRole"
                         id="weaviate.roleDelete" label="Delete Role">
                    <parameter name="operation" value="delete"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
                         id="weaviate.userCreate" label="Create User...">
                    <parameter name="operation" value="create"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
                         id="weaviate.userActivateAll" label="Activate All Users">
                    <parameter name="operation" value="activateAll"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageUsersFolder"
                         id="weaviate.userDeactivateAll" label="Deactivate All Users">
                    <parameter name="operation" value="deactivateAll"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                         id="weaviate.userRoles" label="Assign Roles...">
                    <parameter name="operation" value="roles"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                         id="weaviate.userActivate" label="Activate User">
                    <parameter name="operation" value="activate"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                         id="weaviate.userDeactivate" label="Deactivate User">
                    <parameter name="operation" value="deactivate"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                         id="weaviate.userRotate" label="Rotate API Key...">
                    <parameter name="operation" value="rotate"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageDbUser"
                         id="weaviate.userDelete" label="Delete User">
                    <parameter name="operation" value="delete"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageOidcGroup"
                         id="weaviate.groupRoles" label="Group Roles...">
                    <parameter name="operation" value="roles"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageOidcGroup"
                         id="weaviate.groupRevokeAll" label="Withdraw All Roles">
                    <parameter name="operation" value="revokeAll"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicateShard"
                         id="weaviate.replicateShard" label="Move or Copy Replica...">
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationWatch"
                         id="weaviate.replicationWatch" label="Follow Movement...">
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationCancel"
                         id="weaviate.replicationCancel" label="Cancel Movement">
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationDelete"
                         id="weaviate.replicationDelete" label="Delete Movement">
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationFolder"
                         id="weaviate.replicationDeleteAll" label="Delete All Records">
                    <parameter name="operation" value="deleteAll"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.replicationFolder"
                         id="weaviate.replicationForceDelete" label="Force Delete Records...">
                    <parameter name="operation" value="forceDelete"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                name="Read Docs"
                description="Open the Weaviate documentation for this item"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- The driver icon is already a 16x16 PNG in the model bundle, which this
             bundle requires, so the docs link is marked as going to Weaviate's docs
             without shipping another asset. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
               icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition depends on the navigator folder's meta id,
             which no built-in property tester exposes, and a tester shipped from this
             lazy bundle would evaluate as NOT_LOADED before the bundle is activated.
             WeaviateReadDocsHandler.setEnabled() computes it instead. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReadDocsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.openModuleDocs"
                name="Read Docs"
                description="Open the documentation this module reports for itself"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- The same driver icon the folder-level Read Docs uses, so the two read as one action
             even though one opens Weaviate's docs and the other usually opens a vendor's. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.openModuleDocs"
               icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition is whether this module reported a documentationHref,
             which no built-in property tester exposes, and a tester from this lazily-activated
             bundle evaluates as NOT_LOADED before the bundle starts. setEnabled() computes it. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.openModuleDocs"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateOpenModuleDocsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                name="Select Tenant..."
                description="Choose which tenant's data the Data tab shows"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateSelectTenantHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
                name="Manage Tenants..."
                description="Activate or deactivate this collection's tenants"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- All borrowed from the shared UI bundle rather than shipping new assets.
             manageTenants: configuring how a collection is partitioned.
             selectTenant:  a partition, the same icon a tenant node carries in the tree, so the
                            command and the thing it picks look like each other.
             exportSchema:  the platform's own export arrow. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/config_table.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
               icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/partition.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/sql/table_export.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the action is offered on the collection, its Multi-Tenancy and
             Tenants folders, and a single tenant. Folders are matched on their meta id, which no
             built-in property tester exposes, and a tester from this lazily-activated bundle
             would evaluate as NOT_LOADED before the bundle starts. The handler's setEnabled()
             computes it instead, as WeaviateReadDocsHandler does. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateManageTenantsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState"
                name="Activate Tenant"
                description="Activate or deactivate the selected tenants"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: enablement depends on the selected tenants' states, which no
             built-in property tester exposes. setEnabled() computes it, as the other tenancy
             handlers do. The label and icon are set per selection in updateElement, so the
             command name above is never displayed. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateToggleTenantStateHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                name="Automatic Tenants"
                description="Turn automatic tenant creation or activation on and off"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <!-- Which of the two settings an invocation is about. The label shown in the menu is
                 set per element by the handler, so the command name above is never displayed. -->
            <commandParameter id="option" name="Option" optional="false"/>
        </command>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition is a folder meta id, which no built-in property
             tester exposes, and a tester from this lazily-activated bundle evaluates as
             NOT_LOADED before the bundle starts. setEnabled() computes it. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateToggleAutoTenantHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
                name="Preview Tokenization..."
                description="Show how this property's analyzer splits text"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- Borrowed from the shared UI bundle, which this one already requires, rather than
             shipping another asset. "Find text" is the nearest existing idea to looking inside
             a string and seeing what it is made of. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/find_text.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: an <instanceof> on WeaviateProperty covers the type but not the
             condition that matters, which is whether the property is tokenized. That is not
             expressible without a property tester, and a tester from this lazily activated bundle
             evaluates as NOT_LOADED before the bundle is active, so the item would never appear
             and the bundle would never activate to make it appear. WeaviateReadDocsHandler
             records the same reasoning. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviatePreviewTokenizationHandler"/>
    </extension>

    <!-- Registers the searchable tenant picker with the model bundle. The read path may need
         to ask for a tenant before any Weaviate UI has been opened, so this cannot wait for a
         page or panel to load. -->
    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.weaviate.ui.createBackup"
                 name="Create New Backup..."
                 description="Back up collections to a backup backend"
                 categoryId="org.jkiss.dbeaver.core.navigator"/>
        <command id="org.jkiss.dbeaver.ext.weaviate.ui.restoreBackup"
                 name="Restore Backup..."
                 description="Restore collections from this backup"
                 categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.weaviate.ui.setShardStatus"
                 name="Set Selected Shards Status"
                 description="Set every shard under the selection to READY or READONLY"
                 categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- Labels and icons are set per selection in updateElement, so the command names above
             are never displayed. No <enabledWhen>: the conditions are the shards' current states,
             which no built-in property tester exposes. -->
        <handler commandId="org.jkiss.dbeaver.ext.weaviate.ui.setShardStatus"
                 class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateShardStatusHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.weaviate.ui.backupDocs"
                 name="Read more about Weaviate Backups"
                 description="How to configure a backup backend on the server"
                 categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.backupDocs"
               icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- Offered only on a backend whose module is off, and on the row that appears when none
             is enabled. Those rows say what is missing; this says what to do about it. -->
        <handler commandId="org.jkiss.dbeaver.ext.weaviate.ui.backupDocs"
                 class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateBackupDocsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.weaviate.ui.deleteCollections"
                 name="Delete Collections"
                 description="Delete the selected collections, or all of them, in one operation"
                 categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- Only for several collections at once, or the Collections folder. A single collection
             is already handled by the platform's Delete, which also gives the navigator refresh
             and the standard confirmation; a second Delete entry beside it would just make the
             menu ambiguous. -->
        <handler commandId="org.jkiss.dbeaver.ext.weaviate.ui.deleteCollections"
                 class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateDeleteCollectionsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.createBackup"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/file/export.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.restoreBackup"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/file/import.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.deleteCollections"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/object_remove.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- These put Backup and Restore directly on the context menu. Registering the tasks
             already contributes them under the "Tools" submenu, which is where pg_dump lives,
             but that is two levels down and every other action in this plugin is top level.
             Both routes open the same wizard on the same task.

             No <enabledWhen>: the conditions are "this backend's module is enabled" and "this
             backup succeeded", neither of which a built-in property tester exposes, and a tester
             from this lazily-activated bundle evaluates as NOT_LOADED before the bundle starts. -->
        <handler commandId="org.jkiss.dbeaver.ext.weaviate.ui.createBackup"
                 class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateCreateBackupHandler"/>
        <handler commandId="org.jkiss.dbeaver.ext.weaviate.ui.restoreBackup"
                 class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateRestoreBackupHandler"/>
    </extension>

    <extension point="org.jkiss.dbeaver.task.ui">
        <!-- One configurator for both tasks; the wizard reads the task type to decide which of
             the two it is building. -->
        <configurator type="weaviateBackupCreate"
                      class="org.jkiss.dbeaver.ext.weaviate.ui.tasks.WeaviateBackupTaskConfigurator"
                      supportsPanel="false"/>
        <configurator type="weaviateBackupRestore"
                      class="org.jkiss.dbeaver.ext.weaviate.ui.tasks.WeaviateBackupTaskConfigurator"
                      supportsPanel="false"/>
    </extension>

    <extension point="org.jkiss.dbeaver.tools">
        <!-- Registering the tool is all that is needed for the entry to appear in both the
             navigator's Tools submenu and the Database menu; the platform contributes those.
             Enablement comes from the tasks' own <objectType> matching, which is evaluated in the
             always-active tasks.ui.view bundle and so avoids the NOT_LOADED problem every
             hand-rolled command in this plugin has had to work around. -->
        <tools>
            <tool id="org.jkiss.dbeaver.ext.weaviate.tools.Backup"
                  label="Create New Backup..." description="Back up collections to a backend"
                  icon="#export" singleton="false">
                <task id="weaviateBackupCreate"/>
            </tool>
            <tool id="org.jkiss.dbeaver.ext.weaviate.tools.Restore"
                  label="Restore Backup..." description="Restore collections from this backup"
                  icon="#import" singleton="true">
                <task id="weaviateBackupRestore"/>
            </tool>
        </tools>
    </extension>

    <extension point="org.eclipse.ui.startup">
        <startup class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateUIStartup"/>
    </extension>

</plugin>
