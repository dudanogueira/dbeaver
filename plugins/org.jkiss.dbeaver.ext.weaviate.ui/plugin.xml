<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceEditorView"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
    </extension>

    <extension point="org.jkiss.dbeaver.resultset.panel">
        <panel
                id="weaviate-query"
                label="Weaviate Query"
                description="Run BM25, near text, near vector or hybrid queries against the active Weaviate collection."
                icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"
                default="true"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateQueryPanel">
            <datasource id="weaviate"/>
        </panel>
    </extension>

    <!-- Dialog shown when creating a new collection: edits the JSON definition staged by
         WeaviateCollectionManager#createNewObject. -->
    <extension point="org.jkiss.dbeaver.databaseEditor">
        <configurator class="org.jkiss.dbeaver.ext.weaviate.ui.config.WeaviateCollectionConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
        </configurator>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                name="Export Collection Schema..."
                description="Save this collection's definition as JSON"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateExportSchemaHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState">
                <visibleWhen checkEnabled="true"/>
            </command>
            <!-- Grouped in a submenu because these two are collection-wide settings sitting
                 beside per-tenant actions, and at the top level they read as though they were
                 more of the same. No visibleWhen on the menu itself: the children carry
                 checkEnabled and the popup drops a submenu whose contributions are all
                 invisible, which is how org.jkiss.dbeaver.cmp.simple.ui contributes its own.

                 Both entries are the same command told apart by its option parameter. Their
                 labels and icons are set per selection in the handler's updateElement, so each
                 names the change it will make rather than carrying a tick to interpret. -->
            <menu id="weaviate-multi-tenant-options" label="Multi-Tenant Options"
                  icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/tools.svg">
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                         id="weaviate.autoTenantCreation">
                    <parameter name="option" value="creation"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
                <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                         id="weaviate.autoTenantActivation">
                    <parameter name="option" value="activation"/>
                    <visibleWhen checkEnabled="true"/>
                </command>
            </menu>
            <!-- checkEnabled hides the item on a property that is not tokenized at all, which
                 is a permanent fact about that property. A server merely being too old is not
                 handled by hiding: the handler leaves the command enabled and rewrites its label
                 to name the version required, so the feature stays discoverable. -->
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                name="Read Docs"
                description="Open the Weaviate documentation for this item"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- The driver icon is already a 16x16 PNG in the model bundle, which this
             bundle requires, so the docs link is marked as going to Weaviate's docs
             without shipping another asset. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
               icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition depends on the navigator folder's meta id,
             which no built-in property tester exposes, and a tester shipped from this
             lazy bundle would evaluate as NOT_LOADED before the bundle is activated.
             WeaviateReadDocsHandler.setEnabled() computes it instead. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReadDocsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                name="Select Tenant..."
                description="Choose which tenant's data the Data tab shows"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateSelectTenantHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
                name="Manage Tenants..."
                description="Activate or deactivate this collection's tenants"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- All borrowed from the shared UI bundle rather than shipping new assets.
             manageTenants: configuring how a collection is partitioned.
             selectTenant:  a partition, the same icon a tenant node carries in the tree, so the
                            command and the thing it picks look like each other.
             exportSchema:  the platform's own export arrow. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/config_table.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
               icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/partition.svg"/>
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/sql/table_export.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the action is offered on the collection, its Multi-Tenancy and
             Tenants folders, and a single tenant. Folders are matched on their meta id, which no
             built-in property tester exposes, and a tester from this lazily-activated bundle
             would evaluate as NOT_LOADED before the bundle starts. The handler's setEnabled()
             computes it instead, as WeaviateReadDocsHandler does. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.manageTenants"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateManageTenantsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState"
                name="Activate Tenant"
                description="Activate or deactivate the selected tenants"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: enablement depends on the selected tenants' states, which no
             built-in property tester exposes. setEnabled() computes it, as the other tenancy
             handlers do. The label and icon are set per selection in updateElement, so the
             command name above is never displayed. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleTenantState"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateToggleTenantStateHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                name="Automatic Tenants"
                description="Turn automatic tenant creation or activation on and off"
                categoryId="org.jkiss.dbeaver.core.navigator">
            <!-- Which of the two settings an invocation is about. The label shown in the menu is
                 set per element by the handler, so the command name above is never displayed. -->
            <commandParameter id="option" name="Option" optional="false"/>
        </command>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition is a folder meta id, which no built-in property
             tester exposes, and a tester from this lazily-activated bundle evaluates as
             NOT_LOADED before the bundle starts. setEnabled() computes it. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.toggleAutoTenant"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateToggleAutoTenantHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
                name="Preview Tokenization..."
                description="Show how this property's analyzer splits text"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- Borrowed from the shared UI bundle, which this one already requires, rather than
             shipping another asset. "Find text" is the nearest existing idea to looking inside
             a string and seeing what it is made of. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
               icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/misc/find_text.svg"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: an <instanceof> on WeaviateProperty covers the type but not the
             condition that matters, which is whether the property is tokenized. That is not
             expressible without a property tester, and a tester from this lazily activated bundle
             evaluates as NOT_LOADED before the bundle is active, so the item would never appear
             and the bundle would never activate to make it appear. WeaviateReadDocsHandler
             records the same reasoning. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.previewTokenization"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviatePreviewTokenizationHandler"/>
    </extension>

    <!-- Registers the searchable tenant picker with the model bundle. The read path may need
         to ask for a tenant before any Weaviate UI has been opened, so this cannot wait for a
         page or panel to load. -->
    <extension point="org.eclipse.ui.startup">
        <startup class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateUIStartup"/>
    </extension>

</plugin>
