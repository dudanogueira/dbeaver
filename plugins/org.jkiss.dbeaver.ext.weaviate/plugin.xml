<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="org.jkiss.dbeaver.driverManager">
        <category id="vector" name="Vector Databases" description="Vector and embedding databases" icon="#folder_database" rank="6" promoted="true"/>
    </extension>

    <extension point="org.jkiss.dbeaver.task">
        <category id="weaviate" name="Weaviate" description="Weaviate maintenance tasks"
                  icon="icons/weaviate.png"/>

        <!-- Restore carries a confirmation because it is the one operation here that can lose
             data: Weaviate refuses to restore a collection that already exists, and it refuses
             during the schema apply, after the data has already been staged. -->
        <task id="weaviateBackupCreate" type="weaviate"
              name="Create New Backup"
              description="Back up some or all collections to a backup backend"
              icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/file/export.svg"
              handler="org.jkiss.dbeaver.ext.weaviate.model.tasks.WeaviateBackupCreateHandler"
              requiresExportPrivileges="true">
            <datasource id="weaviate"/>
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateBackupBackend"
                        if="object.available"/>
            <!-- Starting from collections is at least as natural as starting from a backend, and
                 it is the only route where the choice of what to back up arrives already made.
                 The connection itself means all of them, which is the wizard's default. -->
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"
                        if="object.dataSource.hasAvailableBackupBackend()"/>
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateDataSource"
                        if="object.hasAvailableBackupBackend()"/>
        </task>
        <task id="weaviateBackupRestore" type="weaviate"
              name="Restore backup"
              description="Restore collections from an existing backup"
              icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/file/import.svg"
              handler="org.jkiss.dbeaver.ext.weaviate.model.tasks.WeaviateBackupRestoreHandler"
              requiresMutability="true"
              confirmationMessage="Restoring writes collections back into this server. A collection that already exists will fail to restore, after its data has been staged. Continue?">
            <datasource id="weaviate"/>
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateBackupNode"
                        if="object.backupStatus.restorable"/>
        </task>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource
            class="org.jkiss.dbeaver.ext.weaviate.WeaviateDataSourceProvider"
            description="Weaviate vector database connector"
            id="weaviate"
            label="Weaviate"
            icon="icons/weaviate.png"
            dialect="weaviate">
            <tree
                  label="Weaviate data source"
                  path="weaviate"
                  icon="icons/weaviate.png">
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                        label="Server Metadata"
                        icon="#folder_info"
                        description="Weaviate server metadata">
                    <items label="Field" itemLabel="Field"
                           path="metadataField" property="metadataFields" icon="#info"/>
                    <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateModule"
                            label="Modules"
                            icon="#folder_admin"
                            description="Server modules">
                        <items label="Module" itemLabel="Module"
                               path="module" property="modules"/>
                    </folder>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateNode"
                        label="Cluster Nodes"
                        icon="#folder_admin"
                        description="Weaviate cluster nodes">
                    <items label="Cluster Nodes" itemLabel="Node"
                           path="node" property="nodes" icon="#folder_admin">
                        <!-- Grouped by collection: a node hosting a multi-tenant collection has
                             one shard per tenant, and a flat list gives no clue which collection
                             any of them belongs to. -->
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateShardGroup"
                                id="shardGroups"
                                label="Shards"
                                icon="#folder_partitions"
                                description="Node shards, grouped by collection">
                            <items label="Collection" itemLabel="Collection"
                                   path="shardCollection" property="shardGroups" icon="#folder_table">
                                <!-- An explicit icon so the per-status colour has something to
                                     sit on: the state overlay is composited onto the node icon,
                                     and a row with no icon of its own has nothing to overlay. -->
                                <items label="Shards" itemLabel="Shard"
                                       path="shard" property="shards" icon="#partition"/>
                            </items>
                        </folder>
                    </items>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"
                        label="Collections"
                        icon="#folder_table"
                        description="Weaviate collections">
                    <items label="Collections" itemLabel="Collection"
                           path="collection" property="collections" icon="#folder_table">
                        <!-- The complete definition as the server reports it. The typed folders
                             below are limited to what the bundled client can model; this one is
                             built from the raw JSON, so nothing is hidden. -->
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateJsonNode"
                                id="definition" label="Definition"
                                icon="#folder_info"
                                description="Full collection definition as stored by the server">
                            <items label="Entry" itemLabel="Entry"
                                   path="definitionEntry" property="definitionNodes" icon="#info">
                                <items label="Entry" itemLabel="Entry"
                                       path="definitionChild" property="children" icon="#info"
                                       recursive=".."/>
                            </items>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateProperty"
                                id="properties" label="Properties"
                                icon="#columns"
                                description="Collection properties">
                            <items label="Property" itemLabel="Property"
                                   path="property" property="attributes"/>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateVectorizer"
                                id="vectorizers" label="Vectorizers"
                                icon="#folder_admin"
                                description="Named vector configurations">
                            <items label="Vectorizer" itemLabel="Vectorizer"
                                   path="vectorizer" property="vectorizers">
                                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                        label="Fields" icon="#info" description="Vectorizer fields">
                                    <items label="Field" itemLabel="Field"
                                           path="vectorizerField" property="fields"/>
                                </folder>
                            </items>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateReranker"
                                id="rerankers" label="Rerankers"
                                icon="#folder_admin"
                                description="Reranker modules">
                            <items label="Reranker" itemLabel="Reranker"
                                   path="reranker" property="rerankers">
                                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                        label="Fields" icon="#info" description="Reranker fields">
                                    <items label="Field" itemLabel="Field"
                                           path="rerankerField" property="fields"/>
                                </folder>
                            </items>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="generative" label="Generative" icon="#folder_admin" description="Generative module">
                            <items label="Field" itemLabel="Field"
                                   path="generativeField" property="generativeFields"/>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="replication" label="Replication" icon="#folder_info" description="Replication settings">
                            <items label="Field" itemLabel="Field"
                                   path="replicationField" property="replicationFields"/>
                            <!-- Where the copies actually are, as opposed to how many the config
                                 asks for. This is what a move is planned from: a shard can only
                                 go to a node that does not already hold it. -->
                            <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateShardReplicas"
                                    id="shardReplicas" label="Shard Replicas" icon="#folder_partitions"
                                    description="Which nodes hold a replica of each shard">
                                <items label="Shard" itemLabel="Shard"
                                       path="shardReplica" property="shardReplicas" icon="#partition"/>
                            </folder>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="sharding" label="Sharding" icon="#folder_info" description="Sharding settings">
                            <items label="Field" itemLabel="Field"
                                   path="shardingField" property="shardingFields"/>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="multiTenancy" label="Multi-Tenancy" icon="#folder_info" description="Multi-tenancy settings">
                            <items label="Field" itemLabel="Field"
                                   path="multiTenancyField" property="multiTenancyFields"/>
                            <!-- Nested here rather than beside it: the tenants are what the
                                 multi-tenancy settings above are settings for, and a top-level
                                 Tenants folder sat alongside them as if it were unrelated.
                                 visibleIf keeps it off single-tenant collections, where it would
                                 always be empty. Reading is lazy, so thousands of tenants cost
                                 nothing until it is expanded. -->
                            <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateTenantNode"
                                    id="tenants" label="Tenants" icon="#folder_partitions"
                                    description="Tenants of this multi-tenant collection"
                                    visibleIf="object.isMultiTenant()">
                                <items label="Tenant" itemLabel="Tenant"
                                       path="tenant" property="tenantNodes"/>
                            </folder>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="invertedIndex" label="Inverted Index" icon="#folder_info" description="Inverted index settings">
                            <items label="Field" itemLabel="Field"
                                   path="invertedIndexField" property="invertedIndexFields"/>
                        </folder>
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateMetadataField"
                                id="objectTtl" label="Object TTL" icon="#folder_info" description="Object TTL settings">
                            <items label="Field" itemLabel="Field"
                                   path="objectTtlField" property="objectTtlFields"/>
                        </folder>
                        <!-- The names that resolve to this collection. A filtered view of the
                             connection-wide list below, not a second one: an alias belongs to the
                             server, and two caches for the same objects can disagree. Empty is a
                             real answer here, so unlike Backups and Security there is no advisory
                             row: it means nothing points at this collection yet. -->
                        <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateAlias"
                                id="collectionAliases" label="Aliases" icon="#folder_link"
                                description="Names that resolve to this collection"
                                visibleIf="object.dataSource.aliasSupported">
                            <items label="Alias" itemLabel="Alias"
                                   path="collectionAlias" property="aliases" icon="#synonym"/>
                        </folder>
                    </items>
                </folder>
                <!-- Alternate collection names, server-wide. Also shown per collection above;
                     one cache, filtered two ways, so the two views cannot disagree. Hidden rather
                     than explained on a server too old to have them, per the standing policy:
                     hide what can never apply, explain what merely does not apply yet. -->
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateAlias"
                        id="aliases" label="Aliases" icon="#folder_link"
                        description="Alternate names, each resolving to one collection"
                        visibleIf="object.aliasSupported">
                    <items label="Alias" itemLabel="Alias"
                           path="alias" property="aliases" icon="#synonym"/>
                </folder>
                <!-- No visibleIf: this folder appears on every Weaviate connection, including
                     one with no backup module at all. That case is the reason it exists. An
                     absent folder cannot say "backups are not configured here", and an empty one
                     is indistinguishable from a broken one, so getBackupEntries adds a row that
                     names the setting instead. -->
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateBackupEntry"
                        id="backups" label="Backups" icon="#folder_database"
                        description="Backup backends and the backups they hold">
                    <items label="Backend" itemLabel="Backend"
                           path="backupBackend" property="backupEntries">
                        <items label="Backup" itemLabel="Backup"
                               path="backup" property="backups"/>
                    </items>
                </folder>
                <!-- No visibleIf, for the same reason Backups has none. Weaviate advertises
                     no RBAC capability: /v1/meta carries hostname, version, modules and a gRPC
                     size, and the authz handlers answer whether or not RBAC is enabled, so with
                     it off every endpoint returns 200 and an empty body. An empty Roles folder
                     therefore cannot tell "switched off" from "nobody has defined one", and a
                     folder that vanished would say neither. getSecurityEntries adds a row that
                     names the case instead. -->
                <!-- No visibleIf. Unlike RBAC and backups, the server says plainly which
                     case this is: every replication endpoint answers 501 when the feature is off,
                     so an empty list really does mean nothing is in flight and the advisory row
                     really does mean switched off. Both are worth showing. -->
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateReplicationEntry"
                        id="replicationOps"
                        label="Replication"
                        icon="#folder_partitions"
                        description="Replica movements this cluster is tracking">
                    <items label="Operation" itemLabel="Operation"
                           path="replicationOp" property="replicationEntries" icon="#partition">
                        <items label="State" itemLabel="State"
                               path="replicationStep" property="steps" icon="#attribute"/>
                    </items>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateSecurityEntry"
                        id="security"
                        label="Security"
                        icon="#folder_user"
                        description="Roles, users and permissions">
                    <items label="Entry" itemLabel="Entry"
                           path="securityEntry" property="securityEntries" icon="#info"/>
                    <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateRole"
                            id="roles"
                            label="Roles"
                            icon="#folder_admin"
                            description="Roles defined on this server">
                        <items label="Role" itemLabel="Role"
                               path="role" property="roles" icon="#permissions">
                            <items label="Permission" itemLabel="Permission"
                                   path="rolePermission" property="permissions" icon="#attribute"/>
                        </items>
                    </folder>
                    <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateDbUser"
                            id="dbUsers"
                            label="Users"
                            icon="#folder_user"
                            description="Database users">
                        <items label="User" itemLabel="User"
                               path="dbUser" property="dbUsers" icon="#user">
                            <items label="Role" itemLabel="Role"
                                   path="dbUserRole" property="roleRefs" icon="#permissions"/>
                        </items>
                    </folder>
                    <folder type="org.jkiss.dbeaver.ext.weaviate.model.WeaviateOidcGroup"
                            id="oidcGroups"
                            label="Groups"
                            icon="#folder_user"
                            description="OIDC groups the server has seen">
                        <items label="Group" itemLabel="Group"
                               path="oidcGroup" property="oidcGroups" icon="#user_group">
                            <items label="Role" itemLabel="Role"
                                   path="oidcGroupRole" property="roleRefs" icon="#permissions"/>
                        </items>
                    </folder>
                </folder>
            </tree>
            <drivers managable="false">
                <driver
                    id="weaviate"
                    label="Weaviate"
                    description="Weaviate vector database"
                    class="io.weaviate.client6.v1.api.WeaviateClient"
                    icon="icons/weaviate.png"
                    iconBig="icons/weaviate_big.png"
                    customDriverLoader="true"
                    categories="vector">
                </driver>
            </drivers>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect id="weaviate"
                 parent="basic"
                 class="org.jkiss.dbeaver.ext.weaviate.model.WeaviateDialect"
                 label="Weaviate"
                 description="Weaviate dialect">
        </dialect>
    </extension>

    <extension point="org.jkiss.dbeaver.objectManager">
        <manager class="org.jkiss.dbeaver.ext.weaviate.edit.WeaviateCollectionManager"
                 objectType="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
    </extension>

</plugin>
