<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.weaviate.dataSourceEditorView"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                dataSource="weaviate"
                label="Weaviate Connection"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateConnectionPage">
        </view>
    </extension>

    <extension point="org.jkiss.dbeaver.resultset.panel">
        <panel
                id="weaviate-query"
                label="Weaviate Query"
                description="Run BM25, near text, near vector or hybrid queries against the active Weaviate collection."
                icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"
                default="true"
                class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateQueryPanel">
            <datasource id="weaviate"/>
        </panel>
    </extension>

    <!-- Dialog shown when creating a new collection: edits the JSON definition staged by
         WeaviateCollectionManager#createNewObject. -->
    <extension point="org.jkiss.dbeaver.databaseEditor">
        <configurator class="org.jkiss.dbeaver.ext.weaviate.ui.config.WeaviateCollectionConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
        </configurator>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                name="Export Collection Schema..."
                description="Save this collection's definition as JSON"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateExportSchemaHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.exportSchema">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                name="Read Docs"
                description="Open the Weaviate documentation for this item"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <!-- The driver icon is already a 16x16 PNG in the model bundle, which this
             bundle requires, so the docs link is marked as going to Weaviate's docs
             without shipping another asset. -->
        <image commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
               icon="platform:/plugin/org.jkiss.dbeaver.ext.weaviate/icons/weaviate.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- No <enabledWhen>: the condition depends on the navigator folder's meta id,
             which no built-in property tester exposes, and a tester shipped from this
             lazy bundle would evaluate as NOT_LOADED before the bundle is activated.
             WeaviateReadDocsHandler.setEnabled() computes it instead. -->
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.readDocs"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateReadDocsHandler"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                name="Select Tenant..."
                description="Choose which tenant's data the Data tab shows"
                categoryId="org.jkiss.dbeaver.core.navigator"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.weaviate.ui.selectTenant"
                class="org.jkiss.dbeaver.ext.weaviate.ui.handlers.WeaviateSelectTenantHandler">
            <enabledWhen>
                <with variable="selection">
                    <count value="1"/>
                    <iterate operator="and">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.weaviate.model.WeaviateCollection"/>
                        </adapt>
                    </iterate>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <!-- Registers the searchable tenant picker with the model bundle. The read path may need
         to ask for a tenant before any Weaviate UI has been opened, so this cannot wait for a
         page or panel to load. -->
    <extension point="org.eclipse.ui.startup">
        <startup class="org.jkiss.dbeaver.ext.weaviate.ui.WeaviateUIStartup"/>
    </extension>

</plugin>
